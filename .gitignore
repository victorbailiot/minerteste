# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Windows system folders
/Users/*/Ambiente de Impressão/
/Users/*/PrintHood/
/Users/*/Printers/
/System32/
/Windows/

# Temporary files
*.tmp
*.temp
*.log

# Certificados mTLS (nunca commitar chaves privadas)
certs/*.key
certs/*.p12
certs/*.pfx
certs/*.cer
chave.key
*.key
docs/como-rodar-localmente.md
/.agent
/docs
/test
