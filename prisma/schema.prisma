generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       BigInt                 @id @default(autoincrement())
  email                    String                 @unique @db.VarChar(255)
  name                     String                 @db.VarChar(255)
  phone                    String                 @db.VarChar(20)
  password                 String                 @db.VarChar(255)
  financialPassword         String?                @db.VarChar(255)
  role                     Role                   @default(USER)
  sponsorId                BigInt?
  parentId                 BigInt?
  position                 Position               @default(LEFT)
  preferredSide            Position               @default(LEFT)
  isActive                 Boolean                @default(true)
  autoActivation           Boolean                @default(false)
  lastLogin                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  referralCode             String                 @unique @db.VarChar(6)
  emailVerificationExpires DateTime?
  emailVerificationToken   String?                @db.VarChar(255)
  emailVerified            Boolean                @default(false)
  passwordResetExpires     DateTime?
  passwordResetToken       String?                @db.VarChar(255)
  financialPasswordResetToken String?             @db.VarChar(255)
  financialPasswordResetExpires DateTime?
  cpf                      String?                @unique @db.VarChar(14)
  pagarmeCustomerId        String?                @db.VarChar(100)
  stripeAccountId          String?                @db.VarChar(255)
  country                  String?                @db.VarChar(2)
  documentType             DocumentType?
  documentNumber           String?                @db.VarChar(50)
  phoneCountryCode         String?                @db.VarChar(5)
  phoneNumber              String?                @db.VarChar(20)
  addresses                Address[]
  bankAccount              BankAccount?
  clube300Members          Clube300Member[]
  contracts                Contract[]
  cycles                   Cycle[]
  financialTransactions    FinancialTransaction[]
  pixKey                   PixKey?
  profitDistributions      ProfitDistribution[]
  sourceTransactions       Transaction[]          @relation("TransactionSourceUser")
  transactions             Transaction[]
  unilevelSponsorships     UnilevelUser[]         @relation("UnilevelSponsorship")
  unilevelUser             UnilevelUser?
  unilevelCareerHistory    UnilevelUserCareer[]
  unilevelCareerQueue      UnilevelCareerQueue?   @relation("CareerQueue")
  activations              UserActivation[]
  packages                 UserPackage[]
  sourcePointsHistory      UserPointsHistory[]    @relation("SourceUser")
  pointsHistory            UserPointsHistory[]
  profilePhotos            UserProfilePhoto[]
  parent                   User?                  @relation("BinaryTree", fields: [parentId], references: [id])
  children                 User[]                 @relation("BinaryTree")
  sponsor                  User?                  @relation("Sponsorship", fields: [sponsorId], references: [id])
  referrals                User[]                 @relation("Sponsorship")
  withdrawals              Withdrawal[]
  userRoles                UserRole[]             @relation("UserRoles")
  userPermissions          UserPermission[]       @relation("UserPermissions")
  auditPerformed           PermissionAudit[]      @relation("AuditPerformedBy")
  auditTarget              PermissionAudit[]      @relation("AuditTargetUser")
  directBonusTrackerAsUser DirectBonusLimitTracker[] @relation("DirectBonusUser")
  directBonusTrackerAsSponsor DirectBonusLimitTracker[] @relation("DirectBonusSponsor")
  supportTickets           SupportTicket[]
  supportTicketMessages   SupportTicketMessage[]
  adminActionsPerformed    AdminActionAudit[]     @relation("AdminActionsPerformedBy")
  adminActionsTarget       AdminActionAudit[]     @relation("AdminActionsTarget")
  coupons                  Coupon[]
  profitSchedulesCreated   ProfitSchedule[]       @relation("ProfitScheduleCreatedBy")
  grantedPermissions       UserPermission[]       @relation("GrantedPermissions")
  blacklistEntries        BlacklistEntry[]      @relation("UserBlacklist")
  blacklistEntriesAdded   BlacklistEntry[]      @relation("BlacklistAddedBy")
  blacklistAuditsPerformed BlacklistAudit[]     @relation("BlacklistAuditPerformedBy")
  blacklistAuditsTarget    BlacklistAudit[]     @relation("BlacklistAuditTarget")
  storeOrders              StoreOrder[]           @relation("StoreOrders")
  storeReviews             StoreProductReview[]   @relation("StoreReviews")
  storeWishlist            StoreWishlistItem[]    @relation("StoreWishlist")
  storeCart                StoreCart?             @relation("StoreCart")

  @@map("users")
}

model Address {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt
  street       String   @db.VarChar(255)
  number       String   @db.VarChar(20)
  complement   String?  @db.VarChar(100)
  neighborhood String   @db.VarChar(100)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  postalCode   String   @db.VarChar(20)
  country      String   @db.VarChar(2)
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeOrdersShipping StoreOrder[] @relation("StoreShippingAddress")

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

model BankAccount {
  id                           BigInt            @id @default(autoincrement())
  userId                       BigInt            @unique
  recipientId                  String            @unique @db.VarChar(255)
  recipientName                String            @db.VarChar(255)
  recipientEmail               String            @db.VarChar(255)
  recipientDocument            String            @db.VarChar(20)
  recipientType                RecipientType
  recipientStatus              String            @db.VarChar(50)
  bankCode                     String            @db.VarChar(10)
  bankName                     String?           @db.VarChar(255)
  branchNumber                 String            @db.VarChar(10)
  branchCheckDigit             String?           @db.VarChar(2)
  accountNumber                String            @db.VarChar(20)
  accountCheckDigit            String            @db.VarChar(2)
  accountType                  AccountType
  holderName                   String            @db.VarChar(255)
  holderType                   RecipientType
  holderDocument               String            @db.VarChar(20)
  transferEnabled              Boolean           @default(true)
  transferInterval             TransferInterval  @default(DAILY)
  transferDay                  Int?
  anticipationEnabled          Boolean           @default(false)
  anticipationType             AnticipationType?
  anticipationVolumePercentage Int?
  anticipationDelay            Int?
  metadata                     Json?
  excludedAt                   DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  user                         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, excludedAt])
  @@map("bank_accounts")
}

model UserActivation {
  id                BigInt           @id @default(autoincrement())
  userId            BigInt
  type              ActivationType
  amount            Decimal          @db.Decimal(10, 2)
  bonusUsed         Decimal?         @db.Decimal(10, 2)
  conversionPercent Decimal?         @db.Decimal(5, 2)
  activatedAt       DateTime         @default(now())
  expiresAt         DateTime
  transactionId     BigInt?
  correlationID     String?          @db.VarChar(255)
  status            ActivationStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id])

  @@map("user_activations")
}

model Package {
  id                          BigInt                       @id @default(autoincrement())
  name                        String                       @db.VarChar(100)
  description                 String?
  price                       Decimal                      @db.Decimal(10, 2)
  points                      Int
  isActive                    Boolean                      @default(true)
  cycleBonus                  Decimal                      @db.Decimal(10, 2)
  dailyCycles                 Int                          @default(0)
  totalCycles                 Int                          @default(0)
  profitSharePercent          Decimal                      @default(0.00) @db.Decimal(5, 2)
  percentExtra                Decimal                      @default(0.00) @db.Decimal(5, 2)
  binaryBonusPercent          Decimal                      @default(0.00) @db.Decimal(5, 2)
  binaryBonusDailyLimit       Decimal                      @default(0.00) @db.Decimal(10, 2)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  isUnilevel                  Boolean                      @default(false)
  directBonus                 Decimal                      @default(0.00) @db.Decimal(10, 2)
  reactivationAmount          Decimal                      @default(0.00) @db.Decimal(10, 2)
  reactivationBonus           Decimal                      @default(0.00) @db.Decimal(10, 2)
  boosted                     Decimal                      @default(0.00) @map("booster") @db.Decimal(10, 2)
  maxQuantity                 Int                          @default(50)
  slug                        String?                      @unique @db.VarChar(100)
  clube300Eligible            Boolean                      @default(false)
  clube300Cotas               Int                          @default(1)
  clube300CashbackPercent     Decimal                      @default(0.00) @db.Decimal(5, 2)
  maxInstallments             Int                          @default(6)
  generatesCouponOnPurchase   Boolean                      @default(false)
  visibleOnlyForActiveUsers   Boolean                      @default(false)
  upgradePromotionId          BigInt?
  profitDistributions         ProfitDistribution[]
  unilevelBonuses             UnilevelBonus[]
  unilevelProfitDistributions UnilevelProfitDistribution[]
  userPackages                UserPackage[]
  pointsHistory               UserPointsHistory[]
  directBonusTrackers         DirectBonusLimitTracker[]
  packageMiners               PackageMiner[]
  promotionsFrom              Promotion[]                  @relation("PromotionFromPackage")
  promotionsTo                Promotion[]                  @relation("PromotionToPackage")

  @@map("packages")
}

model Miner {
  id             BigInt          @id @default(autoincrement())
  name           String          @db.VarChar(150)
  address        String          @db.VarChar(255)
  city           String          @db.VarChar(120)
  state          String          @db.VarChar(2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userPackages   UserPackage[]
  packageMiners  PackageMiner[]
  paymentVouchers PaymentVoucher[]
  profitDistributions ProfitDistribution[]
  profitSchedules ProfitSchedule[]
  clube300Members Clube300Member[]

  @@map("miners")
}

model PackageMiner {
  id        BigInt   @id @default(autoincrement())
  packageId BigInt
  minerId   BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  miner     Miner    @relation(fields: [minerId], references: [id], onDelete: Cascade)

  @@unique([packageId, minerId])
  @@index([packageId])
  @@index([minerId])
  @@map("package_miners")
}

model UserPackage {
  id                          BigInt          @id @default(autoincrement())
  userId                      BigInt
  packageId                   BigInt
  minerId                     BigInt?
  isActive                    Boolean         @default(true)
  activatedAt                 DateTime        @default(now())
  expiresAt                   DateTime?
  completedCycles             Int             @default(0)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  transactionId               BigInt?
  isUnilevel                  Boolean         @default(false)
  excludeFromPointsCalculation Boolean?
  directBonusSnapshot         Decimal         @default(0.00) @db.Decimal(10, 2)
  priceSnapshot               Decimal         @default(0.00) @db.Decimal(10, 2)
  renewedDays                 Int?
  clube300Member              Clube300Member?
  miner                       Miner?          @relation(fields: [minerId], references: [id])
  package                     Package         @relation(fields: [packageId], references: [id])
  transaction                 Transaction?    @relation(fields: [transactionId], references: [id])
  user                        User            @relation(fields: [userId], references: [id])

  @@map("user_packages")
}

model Cycle {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt
  packageId       BigInt
  leftPointsUsed  Int
  rightPointsUsed Int
  totalPointsUsed Int
  bonusAmount     Decimal  @db.Decimal(10, 2)
  completedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])

  @@map("cycles")
}

model Transaction {
  id              BigInt            @id @default(autoincrement())
  userId          BigInt?
  type            TransactionType
  amount          Decimal           @db.Decimal(15, 2)
  description     String            @db.VarChar(255)
  referenceId     String?           @db.VarChar(100)
  correlationID   String?           @db.VarChar(255)
  chargeId        String?           @db.VarChar(255)
  pixBrCode       String?
  qrCodeImage     String?           @db.VarChar(500)
  customerName    String?           @db.VarChar(255)
  customerEmail   String?           @db.VarChar(255)
  customerPhone   String?           @db.VarChar(20)
  customerCpfCnpj String?           @db.VarChar(20)
  status          TransactionStatus @default(PENDING)
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  comprovanteUrl  String?           @db.VarChar(500)
  level           Int?
  sourceUserId    BigInt?
  quantity        Int               @default(1)
  transferId      String?           @db.VarChar(255)
  taxa            Decimal?          @db.Decimal(5, 2)
  sourceUser      User?             @relation("TransactionSourceUser", fields: [sourceUserId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])
  userPackages    UserPackage[]
  storeOrders     StoreOrder[]      @relation("StoreOrderTransaction")

  @@map("transactions")
}

model Withdrawal {
  id             BigInt           @id @default(autoincrement())
  userId         BigInt
  amount         Decimal          @db.Decimal(10, 2)
  bankAccount    String           @db.VarChar(255)
  pix            String?          @db.VarChar(255)
  status         WithdrawalStatus @default(PENDING)
  processedBy    BigInt?
  processedAt    DateTime?
  rejectedReason String?
  requestedAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id])

  @@map("withdrawals")
}

model Contract {
  id        BigInt         @id @default(autoincrement())
  userId    BigInt
  packageId BigInt
  title     String         @db.VarChar(255)
  content   String
  version   String         @db.VarChar(20)
  status    ContractStatus @default(PENDING)
  signedAt  DateTime?
  pdfPath   String?        @db.VarChar(500)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])

  @@map("contracts")
}

model ProfitDistribution {
  id            BigInt                   @id @default(autoincrement())
  userId        BigInt
  packageId     BigInt
  minerId       BigInt?
  amount        Decimal                  @db.Decimal(15, 2)
  profitPercent Decimal                  @db.Decimal(5, 2)
  totalProfit   Decimal                  @db.Decimal(15, 2)
  periodStart   DateTime
  periodEnd     DateTime
  status        ProfitDistributionStatus @default(PENDING)
  processedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  miner         Miner?                   @relation(fields: [minerId], references: [id])
  package       Package                  @relation(fields: [packageId], references: [id])
  user          User                     @relation(fields: [userId], references: [id])

  @@index([minerId])
  @@map("profit_distributions")
}

model UserPointsHistory {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt
  points          Int
  packageValue    Decimal   @db.Decimal(10, 2)
  side            Position
  sourceUserId    BigInt?
  sourcePackageId BigInt?
  description     String    @db.VarChar(255)
  createdAt       DateTime  @default(now())
  pointType       PointType @default(ACCRUAL)
  sourcePackage   Package?  @relation(fields: [sourcePackageId], references: [id])
  sourceUser      User?     @relation("SourceUser", fields: [sourceUserId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, side, createdAt])
  @@index([userId, pointType, createdAt])
  @@index([sourceUserId])
  @@map("user_points_history")
}

model Parameter {
  id          BigInt          @id @default(autoincrement())
  key         String          @unique @db.VarChar(255)
  value       String
  type        ParameterType
  description String
  status      ParameterStatus @default(ATIVO)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("parameters")
}

model FinancialTransaction {
  id              BigInt                       @id @default(autoincrement())
  type            FinancialTransactionType
  category        FinancialTransactionCategory
  description     String?
  transactionDate DateTime
  quantity        Decimal?                     @db.Decimal(10, 3)
  unitPrice       Decimal?                     @db.Decimal(10, 2)
  totalAmount     Decimal                      @db.Decimal(15, 2)
  userId          BigInt
  receiptUrls     Json?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  user            User                         @relation(fields: [userId], references: [id])

  @@map("financial_transactions")
}

model PixKey {
  id                BigInt     @id @default(autoincrement())
  userId            BigInt     @unique
  pixKeyType        PixKeyType
  pixKey            String     @db.VarChar(255)
  accountHolderName String     @db.VarChar(255)
  bankName          String     @db.VarChar(255)
  excludedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id])

  @@index([userId, excludedAt])
  @@map("pix_keys")
}

model SystemLog {
  id        BigInt      @id @default(autoincrement())
  level     LogLevel    @default(INFO)
  category  LogCategory
  message   String      @db.VarChar(500)
  details   String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([category, createdAt])
  @@index([level, createdAt])
  @@map("system_logs")
}

model CareerLevel {
  id                     BigInt                       @id @default(autoincrement())
  name                   String                       @db.VarChar(100)
  requiredPoints         Int
  maxTeamVolumePercent   Decimal                      @db.Decimal(5, 2)
  indirectBonusLevels    Int
  reactivationLevels     Int
  extraProfitPercent     Decimal                      @db.Decimal(5, 2)
  travelBonus            String?                      @db.VarChar(255)
  travelValue            Decimal?                     @db.Decimal(10, 2)
  pinImageUrl            String?                      @db.VarChar(500)
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  requiredDirects        Int                          @default(0)
  careerBonusAmount      Decimal?                     @db.Decimal(10, 2)
  careerPrizeDescription String?                      @db.VarChar(255)
  careerPrizeValue       Decimal?                     @db.Decimal(10, 2)
  hasPrizeChoice         Boolean                      @default(false)
  profitDistributions    UnilevelProfitDistribution[]
  careerHistory          UnilevelUserCareer[]
  users                  UnilevelUser[]
  targetRequirements     CareerLevelLegRequirement[]  @relation("CareerRequirementTarget")
  minimumForRequirements CareerLevelLegRequirement[]  @relation("CareerRequirementMinimum")
  flyers                 Flyer[]

  @@map("career_levels")
}

model CareerLevelLegRequirement {
  id               BigInt      @id @default(autoincrement())
  careerId         BigInt
  legSlot          Int
  requiredCareerId BigInt
  includeIndirects Boolean     @default(true)
  minOccurrences   Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  career           CareerLevel @relation("CareerRequirementTarget", fields: [careerId], references: [id])
  requiredCareer   CareerLevel @relation("CareerRequirementMinimum", fields: [requiredCareerId], references: [id])

  @@index([careerId])
  @@index([requiredCareerId])
  @@map("career_level_leg_requirements")
}

model UnilevelUser {
  id                  BigInt                       @id @default(autoincrement())
  userId              BigInt                       @unique
  sponsorId           BigInt?
  careerLevelId       BigInt?
  ownPoints           Int                          @default(0)
  networkPoints       Int                          @default(0)
  totalPoints         Int                          @default(0)
  teamVolume          Decimal                      @default(0) @db.Decimal(15, 2)
  isActive            Boolean                      @default(true)
  pointsLastUpdated   DateTime                     @default(now())
  pointsNeedsRecalc   Boolean                      @default(false)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  sourceBonuses       UnilevelBonus[]              @relation("SourceUser")
  bonuses             UnilevelBonus[]
  profitDistributions UnilevelProfitDistribution[]
  careerLevel         CareerLevel?                 @relation(fields: [careerLevelId], references: [id])
  sponsor             User?                        @relation("UnilevelSponsorship", fields: [sponsorId], references: [id])
  user                User                         @relation(fields: [userId], references: [id])

  @@index([pointsNeedsRecalc, pointsLastUpdated])
  @@map("unilevel_users")
}

model UnilevelBonus {
  id              BigInt            @id @default(autoincrement())
  userId          BigInt
  type            UnilevelBonusType
  amount          Decimal           @db.Decimal(15, 2)
  level           Int?
  sourceUserId    BigInt?
  sourcePackageId BigInt?
  description     String            @db.VarChar(500)
  createdAt       DateTime          @default(now())
  sourcePackage   Package?          @relation(fields: [sourcePackageId], references: [id])
  sourceUser      UnilevelUser?     @relation("SourceUser", fields: [sourceUserId], references: [id])
  user            UnilevelUser      @relation(fields: [userId], references: [id])

  @@map("unilevel_bonuses")
}

model UnilevelProfitDistribution {
  id            BigInt                   @id @default(autoincrement())
  userId        BigInt
  packageId     BigInt
  careerLevelId BigInt?
  amount        Decimal                  @db.Decimal(15, 2)
  profitPercent Decimal                  @db.Decimal(5, 2)
  totalProfit   Decimal                  @db.Decimal(15, 2)
  periodStart   DateTime
  periodEnd     DateTime
  status        ProfitDistributionStatus @default(PENDING)
  processedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  careerLevel   CareerLevel?             @relation(fields: [careerLevelId], references: [id])
  package       Package                  @relation(fields: [packageId], references: [id])
  user          UnilevelUser             @relation(fields: [userId], references: [id])

  @@map("unilevel_profit_distributions")
}

model UnilevelUserCareer {
  id                   BigInt       @id @default(autoincrement())
  userId               BigInt
  careerId             BigInt
  totalNetworkPoints   Int
  validPoints          Int
  maxTeamVolumePercent Decimal      @db.Decimal(5, 2)
  graduatedAt          DateTime     @default(now())
  prizeChoice          String?      @db.VarChar(20)
  career               CareerLevel  @relation(fields: [careerId], references: [id])
  user                 User         @relation(fields: [userId], references: [id])

  @@map("unilevel_user_career")
}

model UnilevelCareerQueue {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @unique
  queuedAt    DateTime  @default(now())
  processed   Boolean   @default(false)
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation("CareerQueue", fields: [userId], references: [id], onDelete: Cascade)

  @@index([processed, attempts])
  @@index([queuedAt])
  @@map("unilevel_career_queue")
}

model DirectBonusLimitTracker {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt
  sponsorId       BigInt
  packageId       BigInt
  totalPaid       Decimal  @default(0) @db.Decimal(15, 2)
  limitAmount     Decimal  @db.Decimal(15, 2)
  limitReached    Boolean  @default(false)
  lastResetAt     DateTime?
  resetCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  package         Package  @relation(fields: [packageId], references: [id])
  sponsor         User     @relation("DirectBonusSponsor", fields: [sponsorId], references: [id])
  user            User     @relation("DirectBonusUser", fields: [userId], references: [id])

  @@unique([userId, sponsorId, packageId])
  @@index([userId, packageId])
  @@index([sponsorId, packageId])
  @@map("direct_bonus_limit_tracker")
}

model Clube300Member {
  id            BigInt      @id @default(autoincrement())
  userId        BigInt
  userPackageId BigInt      @unique
  minerId       BigInt
  memberNumber  Int
  cotas         Int         @default(1)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPackage   UserPackage @relation(fields: [userPackageId], references: [id], onDelete: Cascade)
  miner         Miner       @relation(fields: [minerId], references: [id], onDelete: Cascade)

  @@unique([userId, minerId])
  @@unique([memberNumber, minerId])
  @@index([minerId])
  @@map("clube300_members")
}

model PaymentVoucher {
  id            BigInt               @id @default(autoincrement())
  code          String               @unique @db.VarChar(20)
  beneficiaryId BigInt
  payerId       BigInt?
  packageId     BigInt
  minerId       BigInt?
  amount        Decimal              @db.Decimal(15, 2)
  quantity      Int                  @default(1)
  description   String?              @db.VarChar(500)
  status        PaymentVoucherStatus @default(PENDING)
  expiresAt     DateTime
  paidAt        DateTime?
  transactionId BigInt?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  miner         Miner?               @relation(fields: [minerId], references: [id])

  @@index([code])
  @@index([beneficiaryId])
  @@index([status, expiresAt])
  @@map("payment_vouchers")
}

enum Role {
  USER
  ADMIN
}

enum DocumentType {
  CPF
  PASSPORT
  NATIONAL_ID
  SSN
  DNI
  NIE
  RUT
  CI
  RG
