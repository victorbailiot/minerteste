model StoreCategory {
  id          BigInt           @id @default(autoincrement())
  name        String           @db.VarChar(255)
  description String?          @db.Text
  slug        String           @unique @db.VarChar(255)
  imageUrl    String?          @db.VarChar(500)
  isActive    Boolean          @default(true)
  parentId    BigInt?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  parent      StoreCategory?   @relation("CategoryTree", fields: [parentId], references: [id])
  children    StoreCategory[]  @relation("CategoryTree")
  products    StoreProduct[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("store_categories")
}

model StoreProduct {
  id            BigInt                @id @default(autoincrement())
  name          String                @db.VarChar(255)
  description   String                @db.Text
  shortDesc     String?               @db.VarChar(500)
  sku           String                @unique @db.VarChar(100)
  slug          String                @unique @db.VarChar(255)
  price         Decimal               @db.Decimal(10, 2)
  comparePrice  Decimal?              @db.Decimal(10, 2)
  costPrice     Decimal?              @db.Decimal(10, 2)
  categoryId    BigInt
  type          StoreProductType      @default(PHYSICAL)
  stock         Int                   @default(0)
  lowStockAlert Int                   @default(5)
  weight        Decimal?              @db.Decimal(10, 2)
  width         Decimal?              @db.Decimal(10, 2)
  height        Decimal?              @db.Decimal(10, 2)
  length        Decimal?              @db.Decimal(10, 2)
  originZipCode String?               @db.VarChar(10)
  images        String[]
  mainImage     String?               @db.VarChar(500)
  featured      Boolean               @default(false)
  isActive      Boolean               @default(true)
  tags          String[]
  specifications Json?
  metaTitle     String?               @db.VarChar(255)
  metaDescription String?             @db.VarChar(500)
  digitalFileUrl String?              @db.VarChar(500)
  generatesCoupon Boolean            @default(false)
  promotionId    BigInt?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  category      StoreCategory         @relation(fields: [categoryId], references: [id])
  promotion     Promotion?             @relation(fields: [promotionId], references: [id])
  variants      StoreProductVariant[]
  reviews       StoreProductReview[]
  orderItems    StoreOrderItem[]
  wishlistItems StoreWishlistItem[]
  cartItems     StoreCartItem[]     @relation("StoreCartProduct")

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([promotionId])
  @@index([isActive, featured])
  @@index([price])
  @@map("store_products")
}

model StoreProductVariant {
  id          BigInt           @id @default(autoincrement())
