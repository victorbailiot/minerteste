  id        BigInt       @id @default(autoincrement())
  userId    BigInt
  productId BigInt
  createdAt DateTime     @default(now())
  user      User         @relation("StoreWishlist", fields: [userId], references: [id], onDelete: Cascade)
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("store_wishlist_items")
}

model StoreCart {
  id        BigInt         @id @default(autoincrement())
  userId    BigInt         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation("StoreCart", fields: [userId], references: [id], onDelete: Cascade)
  items     StoreCartItem[]

  @@index([userId])
  @@map("store_carts")
}

model StoreCartItem {
  id         BigInt               @id @default(autoincrement())
  cartId     BigInt
  productId  BigInt
  variantId  BigInt?
  quantity   Int
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  cart       StoreCart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    StoreProduct         @relation("StoreCartProduct", fields: [productId], references: [id], onDelete: Cascade)
  variant    StoreProductVariant? @relation("StoreCartVariant", fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@map("store_cart_items")
}

model StoreDiscountCoupon {
  id           BigInt               @id @default(autoincrement())
  code         String               @unique @db.VarChar(50)
  description  String?              @db.VarChar(500)
  discountType StoreDiscountType
  value        Decimal              @db.Decimal(10, 2)
  minPurchase  Decimal?             @db.Decimal(10, 2)
  maxDiscount  Decimal?             @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int                  @default(0)
  isActive     Boolean              @default(true)
  startsAt     DateTime?
  expiresAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("store_discount_coupons")
}

model StoreShippingMethod {
  id            BigInt   @id @default(autoincrement())
  name          String   @db.VarChar(255)
  description   String?  @db.VarChar(500)
  carrier       String   @db.VarChar(100)
  service       String   @db.VarChar(100)
  estimatedDays Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@map("store_shipping_methods")
}

enum StoreProductType {
  PHYSICAL
  DIGITAL
}

enum StoreOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum StorePaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BALANCE
  BOLETO
}

enum StorePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum StoreDiscountType {
  PERCENTAGE
  FIXED
}